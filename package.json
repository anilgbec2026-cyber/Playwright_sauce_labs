{
  "name": "playwright-saucedemo-framework",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) end-to-end framework for https://www.saucedemo.com using the Page Object Model",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10"
  }
}
